{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "prisma:test": "dotenv -e .env.test -- prisma generate && dotenv -e .env.test -- prisma migrate deploy",
        "prisma:ci": "prisma generate && prisma migrate deploy",
        "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.unit.config.mjs --runInBand",
        "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.mjs --runInBand",
        "test": "npm run prisma:test && dotenv -e .env.test -- npm run test:unit && dotenv -e .env.test -- npm run test:integration",
        "test:ci": "npm run prisma:ci && npm run test:unit && npm run test:integration"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.ts"
        ],
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "extensionsToTreatAsEsm": [
            ".ts"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@prisma/client": "^7.5.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.0",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "jest": "^30.2.0",
        "nodemon": "^3.1.13",
        "prisma": "^7.5.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.5.0",
        "@types/nodemailer": "^8.0.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csrf-csrf": "^4.0.3",
        "dotenv": "^17.2.4",
        "express": "^5.2.1",
        "express-openapi-validator": "^5.6.2",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^8.0.5",
        "pg": "^8.18.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    }
}
