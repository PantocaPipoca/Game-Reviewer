{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.unit.config.mjs",
        "prisma:generate": "npx prisma generate",
        "prisma:migrate:test": "npx dotenv-cli -e .env.test -o -- npx prisma migrate deploy",
        "pretest:integration": "npm run prisma:generate && npm run prisma:migrate:test",
        "test:integration": "npx dotenv-cli -e .env.test -o -- cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.mjs --runInBand",
        "test": "npm run test:unit && npm run test:integration"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
        "**/tests/**/*.test.ts"
        ],
        "transform": {
        "^.+\\.ts$": [
            "ts-jest",
            {
            "useESM": true
            }
        ]
        },
        "extensionsToTreatAsEsm": [
        ".ts"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@prisma/client": "^7.3.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.0",
        "@types/supertest": "^7.2.0",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "jest": "^30.2.0",
        "nodemon": "^3.1.13",
        "prisma": "^7.3.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.3.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^17.2.4",
        "express": "^5.2.1",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.18.0"
    }
}
