// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    //url      = env("DATABASE_URL")
}

model User {
    accountName     String   @id
    passwordHash    String
    avatar          String?
    userData        Json // defined in Types.ts
    isPrivate       Boolean  @default(false)
    email           String   @unique
    emailValidation Int?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    reviews   Review[]
    following Follower[] @relation("Follows")
    followers Follower[] @relation("Followed")
    comments  Comment[]
    likes     Like[]
}

model Game {
    gameID   Int    @id
    gameName String
    metadata Json // tags, average time to complete, idk

    reviews Review[]
}

model Review {
    reviewer   String
    reviewed   Int
    text       String
    score      Int
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user User @relation(fields: [reviewer], references: [accountName], onDelete: Cascade)
    game Game @relation(fields: [reviewed], references: [gameID], onDelete: Cascade)

    comments Comment[]
    likes    Like[]

    @@id([reviewer, reviewed])
    @@index([reviewer])
    @@index([reviewed])
    @@index([createdAt])
}

model Follower {
    follows    String
    followed   String
    accepted   Boolean
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    followsUser  User @relation("Follows", fields: [follows], references: [accountName], onDelete: Cascade)
    followedUser User @relation("Followed", fields: [followed], references: [accountName], onDelete: Cascade)

    @@id([follows, followed])
    @@index([followed])
}

model Comment {
    id          BigInt   @id @default(autoincrement()) // prisma forces primary key to exist
    commentator String
    reviewer    String
    reviewed    Int
    text        String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    review Review @relation(fields: [reviewer, reviewed], references: [reviewer, reviewed], onDelete: Cascade)
    user   User   @relation(fields: [commentator], references: [accountName], onDelete: Cascade)

    @@index([reviewer, reviewed])
    @@index([commentator])
}

model Like {
    liker     String
    reviewer  String
    reviewed  Int
    value     Boolean
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    review Review @relation(fields: [reviewer, reviewed], references: [reviewer, reviewed], onDelete: Cascade)
    user   User   @relation(fields: [liker], references: [accountName], onDelete: Cascade)

    @@id([liker, reviewer, reviewed])
    @@index([reviewer, reviewed])
    @@index([liker])
}
